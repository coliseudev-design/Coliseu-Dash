# ============================================================
# COLISEU SYNC AGENT - Configuracao
# ============================================================
# Copie este arquivo para .env e ajuste os valores

# -------- FIREBIRD (local) --------
FIREBIRD_HOST=localhost
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=C:\PROJETOS COLISEU\Bancodedados\COMPENSADOSMAMA1203.FDB
FIREBIRD_USER=SYSDBA
FIREBIRD_PASSWORD=masterkey
FIREBIRD_CHARSET=UTF8

# -------- API COLISEU DASH --------
# Em produção use a URL real do Cloudflare Pages:
# API_URL=https://coliseu-dash.pages.dev
API_URL=http://localhost:3000

# Chave de autenticacao do agente (deve bater com SYNC_API_KEY no Cloudflare)
SYNC_API_KEY=coliseu-sync-key-dev-2026

# -------- SINCRONIZACAO --------
SYNC_BATCH_SIZE=500
SYNC_INTERVAL_MINUTES=5

# -------- LOG --------
LOG_FILE=coliseu_sync.log
LOG_LEVEL=INFO
